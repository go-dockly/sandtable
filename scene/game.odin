package scene

// Level -> Commandos mission (algo-boyz/commandos, mission/mission.odin).
//
// The game plays in 2D, top-down: a coordinateSpace of width x height units,
// x and y from the top-left corner, drawn in 3D as (x, height, y). One unit is
// a metre there (a guard is 0.8 across, a building 4 tall), so the export maps
// one metre of the capture to one unit:
//
//   game x = (world x - origin.x) / worldScale
//   game y = (world z - origin.z) / worldScale
//
// The same axes as sandtable's (+X right, +Z towards the viewer at azimuth 0,
// +Y up), so nothing is mirrored. `origin` and `size` are the level's game
// region, kept in the level, so a car added later does not shift every
// coordinate a designer has typed into the mission.
//
// What the game gets, merged into the designer's own mission.base.json
// (spawn, guards, objective, walls: everything sandtable does not know about):
//
//   buildings  the capture's structures (terrain cells 2 m and more above the
//              ground: buildings, walls, also trees) on a 1 m grid, merged
//              into rectangles, so the player cannot walk through Krakow and
//              guards cannot see through it. "height" is extra: metres.
//   cover      each placed object's footprint as "crate" rectangles: the game's
//              solids are axis-aligned, so a turned car is traced at 25 cm.
//              Crates block movement and sight, as a car should.
//   props      every object, for drawing its GLB later: asset, position,
//              elevation, yaw, scale, tilt, size. The game ignores it for now.
//   sandtable  where it came from and how to map back.

import "core:encoding/json"
import "core:fmt"
import "core:math"
import "core:slice"
import "core:strings"

import "../terrain"

MISSION_FORMAT_NOTE :: "generated by sandtable from the level: edit the level or the base mission, not this file"

// The level's "game" section.
Game :: struct {
	mission:   string, // the mission to write, relative to the level file
	base:      string, // the designer's mission it is merged into, relative to the level; "" none
	origin:    [2]f32, // world x, z of game (0, 0)
	size:      [2]f32, // metres = game units
	buildings: Maybe(bool) `json:"buildingsFromTerrain"`, // default true
}

game_buildings :: proc(g: Game) -> bool {
	b, has := g.buildings.?
	return b if has else true
}

// The region of a terrain, for a level that has no game section yet: all of
// it, in whole metres.
default_region :: proc(t: terrain.Terrain, world_scale: f32) -> (origin, size: [2]f32) {
	ws := world_scale if world_scale > 0 else 1
	origin = t.origin
	size = {
		math.ceil(f32(t.w) * t.cell / ws),
		math.ceil(f32(t.h) * t.cell / ws),
	}
	return
}

to_game :: proc(g: Game, world_scale: f32, world_xz: [2]f32) -> [2]f32 {
	return (world_xz - g.origin) / world_scale
}

to_world :: proc(g: Game, world_scale: f32, game_xy: [2]f32) -> [2]f32 {
	return g.origin + game_xy * world_scale
}

// An object as the export needs it. main fills these from the placement.
Export_Object :: struct {
	id:       u64,
	asset:    string, // the model's path relative to the mission file; "" none
	position: [3]f32, // world
	rotation: [3]f32, // radians, .y is the yaw (raylib MatrixRotateY, counter-clockwise from above)
	scale:    [3]f32,
	up:       [3]f32,
	size_m:   [3]f32, // the model's own size in metres (bounds), before scale. 0: missing model
}

Export_Stats :: struct {
	buildings:      int, // rectangles from the terrain
	cover:          int, // rectangles from objects
	props:          int,
	outside:        int, // objects outside the region: not exported
	grid_w, grid_h: int, // the game's navigation grid, cells
}

Rect :: struct {
	x, y, w, h: f32,
}

// ---------------------------------------------------------------------------
// Rectangles from a mask
// ---------------------------------------------------------------------------

// Covers the set cells of a w x h mask (row-major, row = y) with rectangles,
// greedily: the widest run from the first free cell, grown down while the
// rows below have the same run free. Exact (every set cell covered once, no
// unset cell covered), few rectangles for blocky shapes. Cells, not metres.
merge_rects :: proc(mask: []bool, w, h: int, allocator := context.allocator) -> [][4]int {
	out := make([dynamic][4]int, allocator)
	used := make([]bool, len(mask), context.temp_allocator)
	free :: proc(mask, used: []bool, i: int) -> bool {return mask[i] && !used[i]}
	for y in 0 ..< h {
		for x in 0 ..< w {
			if !free(mask, used, y * w + x) do continue
			rw := 1
			for x + rw < w && free(mask, used, y * w + x + rw) do rw += 1
			rh := 1
			grow: for y + rh < h {
				for k in 0 ..< rw {
					if !free(mask, used, (y + rh) * w + x + k) do break grow
				}
				rh += 1
			}
			for j in 0 ..< rh {
				for k in 0 ..< rw do used[(y + j) * w + x + k] = true
			}
			append(&out, [4]int{x, y, rw, rh})
		}
	}
	return out[:]
}

// ---------------------------------------------------------------------------
// Captured structures -> buildings
// ---------------------------------------------------------------------------

BUILDING_CELL_M    :: f32(1)   // the game's navigation cell
BUILDING_MIN_AREA  :: f32(2)   // m²: lamp posts, stray splats
BUILDING_SUBSAMPLE :: 2        // per side, per cell: a cell is solid if half its samples are structure

// The capture's structures in the region as game rectangles, with the
// tallest structure in each one (metres above the ground).
buildings_from_terrain :: proc(
	t: terrain.Terrain, g: Game, world_scale: f32, allocator := context.allocator,
) -> (rects: []Rect, heights: []f32) {
	gw := int(math.ceil(g.size.x / BUILDING_CELL_M))
	gh := int(math.ceil(g.size.y / BUILDING_CELL_M))
	if !terrain.valid(t) || gw <= 0 || gh <= 0 do return nil, nil
	mask := make([]bool, gw * gh, context.temp_allocator)
	tall := make([]f32, gw * gh, context.temp_allocator)
	S :: BUILDING_SUBSAMPLE
	for y in 0 ..< gh {
		for x in 0 ..< gw {
			hits := 0
			for sj in 0 ..< S {
				for si in 0 ..< S {
					gp := [2]f32{
						(f32(x) + (f32(si) + 0.5) / S) * BUILDING_CELL_M,
						(f32(y) + (f32(sj) + 0.5) / S) * BUILDING_CELL_M,
					}
					wp := to_world(g, world_scale, gp)
					c, inside := terrain.cell_index(t, wp.x, wp.y)
					if !inside || t.class[c] != .Structure do continue
					hits += 1
					tall[y * gw + x] = max(tall[y * gw + x], (t.surface[c] - t.ground[c]) / world_scale)
				}
			}
			mask[y * gw + x] = hits * 2 >= S * S
		}
	}
	cells := merge_rects(mask, gw, gh, context.temp_allocator)
	out := make([dynamic]Rect, allocator)
	hs := make([dynamic]f32, allocator)
	for r in cells {
		area := f32(r[2] * r[3]) * BUILDING_CELL_M * BUILDING_CELL_M
		if area < BUILDING_MIN_AREA do continue
		top: f32
		for j in 0 ..< r[3] {
			for k in 0 ..< r[2] do top = max(top, tall[(r[1] + j) * gw + r[0] + k])
		}
		append(&out, Rect{f32(r[0]) * BUILDING_CELL_M, f32(r[1]) * BUILDING_CELL_M, f32(r[2]) * BUILDING_CELL_M, f32(r[3]) * BUILDING_CELL_M})
		append(&hs, top)
	}
	return out[:], hs[:]
}

// ---------------------------------------------------------------------------
// Placed objects -> cover
// ---------------------------------------------------------------------------

FOOTPRINT_CELL_M :: f32(0.25)

// A turned rectangle (centre, half size in its own x / z, yaw as raylib's
// MatrixRotateY) as axis-aligned rectangles: the cells of a 25 cm grid whose
// centres are inside it, merged. Unturned (yaw a multiple of 90°): exactly one.
footprint_rects :: proc(center: [2]f32, half: [2]f32, yaw: f32, allocator := context.allocator) -> []Rect {
	if half.x <= 0 || half.y <= 0 do return nil
	cs, sn := math.cos(yaw), math.sin(yaw)
	// quarter turns: one exact rectangle (no grid rounding)
	q := yaw / (math.PI / 2)
	if abs(q - math.round(q)) < 1e-4 {
		h := half
		if int(math.round(q)) %% 2 == 1 do h = {half.y, half.x}
		out := make([]Rect, 1, allocator)
		out[0] = Rect{center.x - h.x, center.y - h.y, h.x * 2, h.y * 2}
		return out
	}
	// world offset of local (u, v): (cs u + sn v, -sn u + cs v)
	ex := abs(cs) * half.x + abs(sn) * half.y
	ez := abs(sn) * half.x + abs(cs) * half.y
	C :: FOOTPRINT_CELL_M
	x0 := math.floor((center.x - ex) / C) * C
	y0 := math.floor((center.y - ez) / C) * C
	w := int(math.ceil((center.x + ex - x0) / C))
	h := int(math.ceil((center.y + ez - y0) / C))
	mask := make([]bool, w * h, context.temp_allocator)
	for j in 0 ..< h {
		for i in 0 ..< w {
			d := [2]f32{x0 + (f32(i) + 0.5) * C, y0 + (f32(j) + 0.5) * C} - center
			u := cs * d.x - sn * d.y
			v := sn * d.x + cs * d.y
			mask[j * w + i] = abs(u) <= half.x && abs(v) <= half.y
		}
	}
	cells := merge_rects(mask, w, h, context.temp_allocator)
	out := make([]Rect, len(cells), allocator)
	for r, k in cells {
		out[k] = Rect{x0 + f32(r[0]) * C, y0 + f32(r[1]) * C, f32(r[2]) * C, f32(r[3]) * C}
	}
	return out
}

// ---------------------------------------------------------------------------
// The mission
// ---------------------------------------------------------------------------

Export_Input :: struct {
	game:         Game,
	world_scale:  f32,
	ground:       f32,             // world height of game height 0 (the terrain's lowest ground)
	ter:          terrain.Terrain, // structures -> buildings, if valid and game.buildings
	objects:      []Export_Object,
	base:         json.Value,      // the designer's mission, parsed; nil: none
	id, title:    string,          // used when the base has none
	source_level: string,          // the level, relative to the mission file
	terrain_path: string,          // the capture, relative to the mission file
}

// The keys the game reads, in the order they are written; the base's other
// keys follow in name order, then props and sandtable.
@(private)
MISSION_KEYS :: [?]string{
	"id", "title", "version", "terrain", "coordinateSpace", "playerSpawn",
	"extraction", "objective", "buildings", "walls", "cover", "guards", "routes",
}

export_mission :: proc(in_: Export_Input, allocator := context.allocator) -> (text: string, stats: Export_Stats) {
	context.allocator = context.temp_allocator
	g := in_.game
	ws := in_.world_scale if in_.world_scale > 0 else 1
	base, _ := in_.base.(json.Object)
	stats.grid_w = int(math.ceil(g.size.x))
	stats.grid_h = int(math.ceil(g.size.y))

	// ---- generated geometry ----------------------------------------------------
	buildings: []Rect
	heights: []f32
	if terrain.valid(in_.ter) && game_buildings(g) {
		buildings, heights = buildings_from_terrain(in_.ter, g, ws)
	}
	stats.buildings = len(buildings)

	cover := make([dynamic]Rect)
	props := make([dynamic]string)
	for o in in_.objects {
		c := to_game(g, ws, o.position.xz)
		if c.x < 0 || c.y < 0 || c.x > g.size.x || c.y > g.size.y {
			stats.outside += 1
			continue
		}
		size := o.size_m * o.scale
		for r in footprint_rects(c, size.xz * 0.5, o.rotation.y) do append(&cover, r)
		append(&props, fmt.tprintf(
			`{{"id": %d, "asset": %s, "x": %s, "y": %s, "elevation": %s, "yaw": %s, "scale": %s, "up": %s, "size": %s}}`,
			o.id, quote(o.asset), num(mm(c.x)), num(mm(c.y)), num(mm((o.position.y - in_.ground) / ws)),
			num(o.rotation.y), vec(o.scale), vec(o.up), vec(size),
		))
	}
	stats.cover = len(cover)
	stats.props = len(props)

	// ---- the base's lists, plus ours ---------------------------------------------
	items :: proc(base: json.Object, key: string) -> [dynamic]string {
		out := make([dynamic]string)
		if arr, ok := base[key].(json.Array); ok {
			for v in arr do append(&out, compact(v))
		}
		return out
	}
	b_list := items(base, "buildings")
	for r, k in buildings {
		append(&b_list, fmt.tprintf(
			`{{"id": "terrain-%d", "x": %s, "y": %s, "w": %s, "h": %s, "height": %s}}`,
			k + 1, num(r.x), num(r.y), num(r.w), num(r.h), num(math.round(heights[k] * 10) / 10),
		))
	}
	c_list := items(base, "cover")
	for r in cover {
		append(&c_list, fmt.tprintf(`{{"type": "crate", "x": %s, "y": %s, "w": %s, "h": %s}}`, num(cm(r.x)), num(cm(r.y)), num(cm(r.w)), num(cm(r.h))))
	}

	// ---- writing -------------------------------------------------------------------
	b := strings.builder_make()
	first := true
	key :: proc(b: ^strings.Builder, first: ^bool, k: string) {
		strings.write_string(b, "{\n  " if first^ else ",\n  ")
		first^ = false
		fmt.sbprintf(b, "%s: ", quote(k))
	}
	list :: proc(b: ^strings.Builder, items: []string) {
		if len(items) == 0 {
			strings.write_string(b, "[]")
			return
		}
		strings.write_string(b, "[\n")
		for it, i in items {
			fmt.sbprintf(b, "    %s%s\n", it, "," if i + 1 < len(items) else "")
		}
		strings.write_string(b, "  ]")
	}

	for k in MISSION_KEYS {
		switch k {
		case "id", "title":
			if v, ok := base[k]; ok {
				key(&b, &first, k); strings.write_string(&b, compact(v))
			} else {
				key(&b, &first, k); strings.write_string(&b, quote(in_.id if k == "id" else in_.title))
			}
		case "version":
			key(&b, &first, k)
			strings.write_string(&b, compact(base[k]) if k in base else "1")
		case "terrain":
			key(&b, &first, k); strings.write_string(&b, quote(in_.terrain_path))
		case "coordinateSpace":
			key(&b, &first, k)
			fmt.sbprintf(&b, `{{"width": %s, "height": %s, "origin": "top-left", "plane": "top-down"}}`,
				num(math.ceil(g.size.x)), num(math.ceil(g.size.y)))
		case "playerSpawn":
			key(&b, &first, k)
			if v, ok := base[k]; ok {
				strings.write_string(&b, compact(v))
			} else {
				p := free_spot(buildings, cover[:], g.size)
				fmt.sbprintf(&b, `{{"x": %s, "y": %s}}`, num(p.x), num(p.y))
			}
		case "buildings":
			key(&b, &first, k); list(&b, b_list[:])
		case "cover":
			key(&b, &first, k); list(&b, c_list[:])
		case:
			v, ok := base[k]
			if !ok do continue
			key(&b, &first, k)
			if arr, is_arr := v.(json.Array); is_arr {
				lines := make([]string, len(arr))
				for e, i in arr do lines[i] = compact(e)
				list(&b, lines)
			} else {
				strings.write_string(&b, compact(v))
			}
		}
	}
	// whatever else the designer keeps in the base, by name
	known := MISSION_KEYS
	rest := make([dynamic]string)
	outer: for k in base {
		if k == "props" || k == "sandtable" do continue
		for m in known do if m == k do continue outer
		append(&rest, k)
	}
	slice.sort(rest[:])
	for k in rest {
		key(&b, &first, k); strings.write_string(&b, compact(base[k]))
	}
	key(&b, &first, "props"); list(&b, props[:])
	key(&b, &first, "sandtable")
	fmt.sbprintf(&b,
		`{{"note": %s, "level": %s, "origin": %s, "worldScale": %s, "groundHeight": %s, "unit": "metre"}}`,
		quote(MISSION_FORMAT_NOTE), quote(in_.source_level),
		fmt.tprintf("[%s, %s]", num(g.origin.x), num(g.origin.y)), num(ws), num(in_.ground),
	)
	strings.write_string(&b, "\n}\n")
	return strings.clone(strings.to_string(b), allocator), stats
}

// Game units are metres: a centimetre is plenty for a footprint, a millimetre
// for a position, and round numbers keep the file readable.
@(private)
cm :: proc(x: f32) -> f32 {return math.round(x * 100) / 100}
@(private)
mm :: proc(x: f32) -> f32 {return math.round(x * 1000) / 1000}

// The designer's mission, as export_mission takes it. Integers stay integers
// (ids, counts, "version"), so they are written back as they were.
parse_mission :: proc(data: []byte, allocator := context.allocator) -> (v: json.Value, ok: bool) {
	val, err := json.parse(data, json.DEFAULT_SPECIFICATION, parse_integers = true, allocator = allocator)
	if err != nil do return nil, false
	if _, is_obj := val.(json.Object); !is_obj {
		json.destroy_value(val, allocator)
		return nil, false
	}
	return val, true
}

// A JSON value on one line, map keys sorted (stable output).
@(private)
compact :: proc(v: json.Value) -> string {
	data, err := json.marshal(v, {sort_maps_by_key = true}, context.temp_allocator)
	if err != nil do return "null"
	return string(data)
}

// A place to stand for a mission without a spawn: the free 1 m cell nearest
// the middle of the region (not inside a building or a car).
@(private)
free_spot :: proc(buildings, cover: []Rect, size: [2]f32) -> [2]f32 {
	blocked :: proc(p: [2]f32, rs: []Rect) -> bool {
		for r in rs {
			if p.x >= r.x - 1 && p.x <= r.x + r.w + 1 && p.y >= r.y - 1 && p.y <= r.y + r.h + 1 do return true
		}
		return false
	}
	mid := [2]f32{math.floor(size.x / 2) + 0.5, math.floor(size.y / 2) + 0.5}
	reach := int(max(size.x, size.y))
	for ring in 0 ..= reach {
		for dy in -ring ..= ring {
			for dx in -ring ..= ring {
				if max(abs(dx), abs(dy)) != ring do continue
				p := mid + {f32(dx), f32(dy)}
				if p.x < 0 || p.y < 0 || p.x > size.x || p.y > size.y do continue
				if !blocked(p, buildings) && !blocked(p, cover) do return p
			}
		}
	}
	return mid
}
