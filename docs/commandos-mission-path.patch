From bbdd437019704c5fbaf4c1a8f41eada6b83857e1 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 26 Nov 2026 00:26:40 +0100
Subject: [PATCH] Load the mission given on the command line

odin run . -- path/to/mission.json, e.g. a mission exported by sandtable
(ctrl+E). Without an argument: mission/eagle/mission.json, as before.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01KbC3pTsWT6WZXz3NDU1Cmu
---
 main.odin | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/main.odin b/main.odin
index 1f8bf97..a5b5fbe 100644
--- a/main.odin
+++ b/main.odin
@@ -1,6 +1,8 @@
 
 package main
 
+import "core:os"
+
 import rl "vendor:raylib"
 import "camera"
 import "game"
@@ -31,7 +33,11 @@ main :: proc() {
 
     rl.SetTargetFPS(60)
 
-    level, mission_ok := mission.load("mission/eagle/mission.json")
+    // odin run . -- path/to/mission.json   (e.g. a mission exported by sandtable)
+    mission_path := "mission/eagle/mission.json"
+    if len(os.args) > 1 do mission_path = os.args[1]
+
+    level, mission_ok := mission.load(mission_path)
     if !mission_ok {
         return
     }
-- 
